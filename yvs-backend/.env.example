# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
MONGODB_URI=mongodb://YOUR_USER:YOUR_PASSWORD@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin

# Queue (Redis Cloud or local)
REDIS_URL=redis://:YOUR_PASSWORD@redis-xxxxx.cloud.redislabs.com:12345
# OR for local Redis:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Summarization Backend (ollama, gemini, or openai)
SUMMARIZATION_BACKEND=ollama

# Ollama (if using)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Gemini (if using)
# GEMINI_API_KEY=AIzaSy...

# OpenAI (if using)
# OPENAI_API_KEY=sk-proj-...

# Transcription (local or openai)
WHISPER_MODE=local
WHISPER_LOCAL_PATH=whisper

# Binary Paths
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Storage
TEMP_DIR=./tmp

# Job Configuration
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
