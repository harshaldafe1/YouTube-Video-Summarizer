# ─────────────────────────────────────────────────────────────
#  YVS Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ✅ Server Configuration
PORT=5000
NODE_ENV=development

# ✅ MongoDB Atlas — Required for storing video metadata, transcripts, and summaries
# Get free tier at: https://www.mongodb.com/cloud/atlas
# Use direct connection format (non-SRV) with individual shard hostnames
MONGODB_URI=mongodb://YOUR_USER:YOUR_PASSWORD@ac-xxxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-02.xxxxx.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxxxxx-shard-0&authSource=admin&appName=MyApp

# ✅ Redis Configuration — Required for BullMQ job queue
# Option 1: Redis Cloud (Recommended for Windows, free tier available)
# Sign up at: https://redis.io/cloud
# Format: redis://:<password>@<host>:<port>
REDIS_URL=redis://:YOUR_PASSWORD@redis-12345.c1.us-east-1-2.ec2.cloud.redislabs.com:12345

# Option 2: Local Redis (Uncomment if using local Redis instead of Redis Cloud)
# Note: REDIS_URL takes precedence if both are set
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ✅ Summarization Backend — Local Ollama only
# Install Ollama from https://ollama.com/download/windows
# Then run:
#   ollama daemon
#   ollama pull llama3.2
# SUMMARIZATION_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ⚠️ OpenAI API Key — Required ONLY for GPT summarization (NOT for transcription)
# Get your API key at: https://platform.openai.com/api-keys
# Cost: ~$0.001 per summary (transcription is FREE with local Whisper)
OPENAI_API_KEY=sk-proj-...

# ✅ Whisper Configuration — Choose transcription method
# "local"  = FREE, runs on your machine, works offline, unlimited (RECOMMENDED)
# "openai" = Costs $0.006/minute, requires internet, 25MB file limit
WHISPER_MODE=local

# ✅ Local Whisper Path — Required when WHISPER_MODE=local
# Install: pip install openai-whisper
# Windows: Usually 'whisper' or full path to whisper.exe
# Linux/Mac: Usually 'whisper' or '/usr/local/bin/whisper'
WHISPER_LOCAL_PATH=whisper

# ✅ yt-dlp Path — Required for downloading audio from YouTube
# Install: pip install yt-dlp
# Windows: C:\Users\YourName\AppData\Local\Programs\Python\Python310\Scripts\yt-dlp.exe
# Linux/Mac: /usr/local/bin/yt-dlp or just 'yt-dlp'
YTDLP_PATH=yt-dlp

# ✅ FFmpeg Path — Required for audio normalization
# Download from: https://ffmpeg.org/download.html
# Windows: C:\ffmpeg\bin\ffmpeg.exe
# Linux/Mac: /usr/bin/ffmpeg or just 'ffmpeg'
FFMPEG_PATH=ffmpeg

# ✅ Temp Directory — Used for storing temporary audio files during processing
# Relative or absolute path
TEMP_DIR=./tmp

# ✅ BullMQ Job Settings — Configure job retry behavior
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000

# ✅ CORS Origins — Comma-separated list of allowed frontend URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# RECOMMENDED SETUP FOR BEGINNERS
# ─────────────────────────────────────────────────────────────
# 1. MongoDB Atlas (free tier): https://www.mongodb.com/cloud/atlas
# 2. Redis Cloud (free tier): https://redis.io/cloud
# 3. OpenAI API key: https://platform.openai.com/api-keys
# 4. Install Python dependencies:
#    pip install openai-whisper yt-dlp
# 5. Install FFmpeg: https://ffmpeg.org/download.html
# 6. Set WHISPER_MODE=local for free transcription
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# COST BREAKDOWN
# ─────────────────────────────────────────────────────────────
# Transcription (local Whisper): FREE ✅
# Summarization (OpenAI GPT): ~$0.001 per video
# MongoDB Atlas (free tier): FREE (512MB storage)
# Redis Cloud (free tier): FREE (30MB storage)
# Total cost per video: ~$0.001 (just for GPT summary)
# ─────────────────────────────────────────────────────────────
